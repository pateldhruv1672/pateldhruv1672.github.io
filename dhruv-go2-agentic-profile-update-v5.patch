diff --git a/assets/images/go2-agentic-navigation-loop.svg b/assets/images/go2-agentic-navigation-loop.svg
new file mode 100644
index 0000000..2a3ef28
--- /dev/null
+++ b/assets/images/go2-agentic-navigation-loop.svg
@@ -0,0 +1,66 @@
+<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900" role="img" aria-labelledby="title desc">
+  <title id="title">Agentic navigation supervision loop</title>
+  <desc id="desc">A bounded state machine turns a human command into semantic grounding, readiness checks, typed tools, Nav2 execution, observation, evaluation, recovery, and a final report.</desc>
+  <defs>
+    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#090c10"/><stop offset="1" stop-color="#151a20"/></linearGradient>
+    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0"><stop stop-color="#95ff4f"/><stop offset="1" stop-color="#57d7b0"/></linearGradient>
+    <filter id="shadow"><feDropShadow dx="0" dy="16" stdDeviation="18" flood-opacity=".36"/></filter>
+    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#74808d"/></marker>
+    <marker id="greenArrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#8dff47"/></marker>
+    <style>
+      .title{font:700 44px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#f7f8f9}.sub{font:400 20px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#98a2ad}.eyebrow{font:700 14px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:2.5px;fill:#8dff47}.box{fill:#14191f;stroke:#333b45;stroke-width:2;rx:24;filter:url(#shadow)}.box2{fill:#0f1419;stroke:#3d4853;stroke-width:2;rx:20}.h{font:700 22px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#f4f6f7}.p{font:400 16px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#a8b1ba}.mono{font:600 14px ui-monospace,SFMono-Regular,Menlo,monospace;fill:#c9d1d8}.flow{fill:none;stroke:#74808d;stroke-width:3;marker-end:url(#arrow)}.green{fill:none;stroke:#8dff47;stroke-width:3;marker-end:url(#greenArrow)}.gate{fill:#17331f;stroke:#6de074;stroke-width:2;rx:20}.danger{fill:#301b1b;stroke:#d16b6b;stroke-width:2;rx:20}
+    </style>
+  </defs>
+  <rect width="1600" height="900" fill="url(#bg)"/>
+  <circle cx="1480" cy="120" r="260" fill="#8dff47" opacity=".035"/><circle cx="100" cy="850" r="280" fill="#4dd4a7" opacity=".025"/>
+  <text x="82" y="76" class="eyebrow">AGENTIC NAVIGATION · CONTROL AUTHORITY</text>
+  <text x="82" y="126" class="title">A bounded supervisor above a deterministic motion stack</text>
+  <text x="82" y="162" class="sub">Reasoning selects tools. Nav2 executes motion. Safety gates can refuse.</text>
+
+  <rect x="82" y="225" width="250" height="122" class="box"/>
+  <text x="112" y="267" class="h">1 · Human command</text><text x="112" y="300" class="p">Natural language, voice transcript,</text><text x="112" y="325" class="p">or tour checkpoint request.</text>
+
+  <rect x="390" y="225" width="250" height="122" class="box"/>
+  <text x="420" y="267" class="h">2 · Ground intent</text><text x="420" y="300" class="p">Resolve place, object, constraint,</text><text x="420" y="325" class="p">and selected map session.</text>
+
+  <rect x="698" y="225" width="250" height="122" class="gate"/>
+  <text x="728" y="267" class="h">3 · Preflight gate</text><text x="728" y="300" class="p">Localization · lifecycle · scan</text><text x="728" y="325" class="p">collision · motion authority.</text>
+
+  <rect x="1006" y="225" width="250" height="122" class="box"/>
+  <text x="1036" y="267" class="h">4 · Select tool</text><text x="1036" y="300" class="p">Typed arguments, timeout,</text><text x="1036" y="325" class="p">feedback schema, stop rules.</text>
+
+  <rect x="1314" y="225" width="204" height="122" class="box"/>
+  <text x="1344" y="267" class="h">5 · Execute</text><text x="1344" y="300" class="p">Nav2 action or</text><text x="1344" y="325" class="p">bounded observation.</text>
+
+  <path d="M332 286H380" class="green"/><path d="M640 286H688" class="green"/><path d="M948 286H996" class="green"/><path d="M1256 286H1304" class="green"/>
+
+  <rect x="1020" y="425" width="498" height="190" class="box2"/>
+  <text x="1054" y="466" class="eyebrow">DETERMINISTIC EXECUTION PLANE</text>
+  <text x="1054" y="507" class="h">Nav2 + collision monitor + Go2 driver</text>
+  <text x="1054" y="541" class="p">Planner → controller → velocity smoother → /cmd_vel_out</text>
+  <text x="1054" y="571" class="mono">Continuous control never passes through the LLM.</text>
+  <path d="M1416 347V415" class="green"/>
+
+  <rect x="82" y="425" width="260" height="190" class="box"/>
+  <text x="112" y="468" class="h">6 · Observe</text><text x="112" y="502" class="p">Action feedback, camera, scan,</text><text x="112" y="528" class="p">pose, memory, and result code.</text><text x="112" y="571" class="mono">evidence[]</text>
+
+  <rect x="400" y="425" width="260" height="190" class="box"/>
+  <text x="430" y="468" class="h">7 · Evaluate</text><text x="430" y="502" class="p">Goal reached? Target observed?</text><text x="430" y="528" class="p">Hard stop? Retry allowed?</text><text x="430" y="571" class="mono">attempt / budget</text>
+
+  <rect x="718" y="425" width="244" height="190" class="danger"/>
+  <text x="748" y="468" class="h">8 · Recover</text><text x="748" y="502" class="p">One failure-specific action.</text><text x="748" y="528" class="p">No open-ended retry loop.</text><text x="748" y="571" class="mono">budget -= 1</text>
+
+  <path d="M1020 522H972" class="flow"/><path d="M718 522H670" class="flow"/><path d="M400 522H352" class="flow"/>
+  <path d="M840 615V678H515V625" class="flow"/>
+  <path d="M840 615V694H1130V625" class="flow"/>
+
+  <rect x="400" y="690" width="560" height="130" class="box"/>
+  <text x="430" y="735" class="h">9 · Report or continue with explicit state</text>
+  <text x="430" y="770" class="p">The graph returns the action result, evidence, failure reason, and remaining budget.</text>
+  <text x="430" y="798" class="mono">status · stream · speech · memory write</text>
+
+  <rect x="1030" y="690" width="488" height="130" class="gate"/>
+  <text x="1060" y="735" class="h">Hard safety conditions terminate the loop</text>
+  <text x="1060" y="770" class="p">Unlocalized · collision STOP · stale sensing · unconfirmed motion</text>
+  <text x="1060" y="798" class="mono">refuse → stop → explain</text>
+</svg>
