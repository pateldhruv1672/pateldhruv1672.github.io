+<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900" role="img" aria-labelledby="title desc">
+  <title id="title">Omi voice command sequence</title><desc id="desc">A transcript enters the Omi bridge, is classified and verified, then either routes to the agent, a tour, conversation, or an immediate stop path.</desc>
+  <defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#090c10"/><stop offset="1" stop-color="#151a20"/></linearGradient><marker id="a" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#74808d"/></marker><marker id="g" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#8dff47"/></marker><filter id="s"><feDropShadow dx="0" dy="14" stdDeviation="18" flood-opacity=".34"/></filter><style>.title{font:700 44px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#f7f8f9}.sub{font:400 20px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#98a2ad}.ey{font:700 14px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;letter-spacing:2.4px;fill:#8dff47}.box{fill:#151a20;stroke:#38424c;stroke-width:2;rx:23;filter:url(#s)}.gate{fill:#17331f;stroke:#69dc72;stroke-width:2;rx:23}.stop{fill:#321a1a;stroke:#de6c6c;stroke-width:2;rx:23}.h{font:700 21px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#f3f5f6}.p{font:400 15px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;fill:#a8b1ba}.m{font:600 13px ui-monospace,SFMono-Regular,Menlo,monospace;fill:#c7d0d7}.f{fill:none;stroke:#74808d;stroke-width:3;marker-end:url(#a)}.fg{fill:none;stroke:#8dff47;stroke-width:3;marker-end:url(#g)}</style></defs>
+  <rect width="1600" height="900" fill="url(#bg)"/><text x="82" y="78" class="ey">OMI · VOICE INTERACTION AND SAFETY</text><text x="82" y="130" class="title">Voice supplies intent. The autonomy stack still owns execution.</text><text x="82" y="166" class="sub">Transcript-first routing keeps speech, confirmation, agent reasoning, and robot motion separable.</text>
+
+  <rect x="82" y="240" width="240" height="126" class="box"/><text x="112" y="282" class="h">Transcript input</text><text x="112" y="313" class="m">/omi/transcript_raw</text><text x="112" y="339" class="p">Omi/mobile/simulated text</text>
+  <rect x="388" y="240" width="240" height="126" class="box"/><text x="418" y="282" class="h">Normalize + classify</text><text x="418" y="313" class="p">Question · motion · tour</text><text x="418" y="339" class="p">confirmation · immediate stop</text>
+  <rect x="694" y="240" width="240" height="126" class="gate"/><text x="724" y="282" class="h">Verification gate</text><text x="724" y="313" class="m">request / state</text><text x="724" y="339" class="p">Required for motion and tours</text>
+  <rect x="1000" y="240" width="240" height="126" class="box"/><text x="1030" y="282" class="h">Agent or tour route</text><text x="1030" y="313" class="p">Ground target and choose</text><text x="1030" y="339" class="p">typed tools/checkpoints</text>
+  <rect x="1306" y="240" width="212" height="126" class="box"/><text x="1336" y="282" class="h">Feedback</text><text x="1336" y="313" class="p">TTS, status, result,</text><text x="1336" y="339" class="p">or refusal</text>
+  <path d="M322 303H378" class="fg"/><path d="M628 303H684" class="fg"/><path d="M934 303H990" class="fg"/><path d="M1240 303H1296" class="fg"/>
+
+  <rect x="388" y="490" width="360" height="180" class="stop"/><text x="422" y="535" class="ey">HIGH-PRIORITY STOP PATH</text><text x="422" y="577" class="h">Stop phrases bypass confirmation</text><text x="422" y="611" class="p">zero velocity → cancel navigation → report</text><text x="422" y="641" class="m">stop · halt · freeze · emergency stop</text>
+  <path d="M508 366V480" class="f"/>
+
+  <rect x="850" y="490" width="668" height="180" class="box"/><text x="884" y="535" class="ey">TOUR AS DATA</text><text x="884" y="577" class="h">JSON checkpoints reference saved semantic places</text><text x="884" y="611" class="p">route id · place id · narration · fun fact · resume requirement</text><text x="884" y="641" class="m">missing route/session → refuse safely</text>
+  <path d="M1120 366V480" class="f"/>
+
+  <rect x="82" y="744" width="1436" height="88" class="gate"/><text x="116" y="780" class="h">Observable topics</text><text x="116" y="811" class="m">/go2_voice/transcript · /go2_voice/verification_request · /go2_voice/verification_state · /go2_agent/user_command · /go2_tts/status · /go2_tour/status</text>
+</svg>
